<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.poli.agro.PrimaryController"   
      prefWidth="900" prefHeight="680"
      spacing="0"
      style="-fx-background-color: #f4f6f0;">

    <!-- ══ HEADER BANNER ══ -->
    <StackPane prefHeight="110" style="-fx-background-color: linear-gradient(to bottom, #4a7c2a, #2d5a1a);">
        <ImageView fx:id="bannerImage" fitWidth="900" fitHeight="110" preserveRatio="false" pickOnBounds="true"/>
        <Label text="Registro de Productos Agrícolas"
               style="-fx-font-family: 'Georgia'; -fx-font-size: 28px; -fx-font-weight: bold;
                      -fx-text-fill: white;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 6, 0.5, 0, 1);"
               translateX="0" translateY="-10">
        </Label>
    </StackPane>

    <!-- ══ BODY ═ -->
    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox.margin><Insets top="12" right="12" bottom="0" left="12"/></VBox.margin>

        <!-- ── LEFT PANEL: Gestión de Producto ── -->
        <VBox prefWidth="310" spacing="10"
              style="-fx-background-color: white; -fx-background-radius: 8;
                     -fx-border-color: #d0d8c8; -fx-border-radius: 8;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <VBox.margin><Insets bottom="12"/></VBox.margin>
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

            <!-- Título panel -->
            <Label text="Gestión de Producto"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 14px; -fx-font-weight: bold;
                          -fx-text-fill: #3a5a2a; -fx-border-color: #c8d8b8;
                          -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;"/>

            <!-- Nombre -->
            <Label text="Nombre del Producto:"
                   style="-fx-font-size: 12px; -fx-text-fill: #4a5a40;"/>
            <TextField fx:id="txtNombre" promptText="Ingrese el nombre"
                       style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                              -fx-border-radius: 5; -fx-font-size: 12px; -fx-padding: 6;"/>

            <!-- Tipo -->
            <Label text="Tipo de Producto:"
                   style="-fx-font-size: 12px; -fx-text-fill: #4a5a40;"/>
            <ComboBox fx:id="cmbTipo" prefWidth="278"
                      style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                             -fx-border-radius: 5; -fx-font-size: 12px;"/>

            <!-- Cantidad -->
            <Label text="Cantidad Disponible:"
                   style="-fx-font-size: 12px; -fx-text-fill: #4a5a40;"/>
            <HBox spacing="6">
                <TextField fx:id="txtCantidad" promptText="0.0" prefWidth="180"
                           style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                                  -fx-border-radius: 5; -fx-font-size: 12px; -fx-padding: 6;"/>
                <TextField fx:id="txtUnidad" promptText="kg / L"
                           style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                                  -fx-border-radius: 5; -fx-font-size: 12px; -fx-padding: 6;"
                           HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Fecha -->
            <Label text="Fecha de Aplicación:"
                   style="-fx-font-size: 12px; -fx-text-fill: #4a5a40;"/>
            <TextField fx:id="txtFecha" promptText="dd/mm/aaaa"
                       style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                              -fx-border-radius: 5; -fx-font-size: 12px; -fx-padding: 6;"/>

            <!-- Campos dinámicos según tipo -->
            <!-- Fertilizante -->
            <VBox fx:id="panelFertilizante" spacing="6" managed="false" visible="false">
                <Label text="Tipo de Fórmula:"
                       style="-fx-font-size: 12px; -fx-text-fill: #4a5a40;"/>
                <TextField fx:id="txtFormula" promptText="Ej: NPK, Urea..."
                           style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                                  -fx-border-radius: 5; -fx-font-size: 12px; -fx-padding: 6;"/>
            </VBox>

            <!-- Pesticida -->
            <VBox fx:id="panelPesticida" spacing="6" managed="false" visible="false">
                <Label text="Plaga Objetivo:"
                       style="-fx-font-size: 12px; -fx-text-fill: #4a5a40;"/>
                <TextField fx:id="txtPlaga" promptText="Ej: Áfidos, Mosca..."
                           style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                                  -fx-border-radius: 5; -fx-font-size: 12px; -fx-padding: 6;"/>
                <Label text="Toxicidad:"
                       style="-fx-font-size: 12px; -fx-text-fill: #4a5a40;"/>
                <TextField fx:id="txtToxicidad" promptText="Ej: Alta, Media, Baja"
                           style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                                  -fx-border-radius: 5; -fx-font-size: 12px; -fx-padding: 6;"/>
            </VBox>

            <!-- Abono -->
            <VBox fx:id="panelAbono" spacing="6" managed="false" visible="false">
                <Label text="Origen:"
                       style="-fx-font-size: 12px; -fx-text-fill: #4a5a40;"/>
                <TextField fx:id="txtOrigen" promptText="Ej: Animal, Vegetal..."
                           style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                                  -fx-border-radius: 5; -fx-font-size: 12px; -fx-padding: 6;"/>
                <Label text="Tiempo de Descomposición (días):"
                       style="-fx-font-size: 12px; -fx-text-fill: #4a5a40;"/>
                <TextField fx:id="txtDias" promptText="Ej: 30"
                           style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                                  -fx-border-radius: 5; -fx-font-size: 12px; -fx-padding: 6;"/>
            </VBox>

            <!-- Observaciones (común a todos) -->
            <Label text="Observaciones:"
                   style="-fx-font-size: 12px; -fx-text-fill: #4a5a40;"/>
            <TextArea fx:id="txtObservaciones" prefRowCount="3" wrapText="true"
                      style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                             -fx-border-radius: 5; -fx-font-size: 12px;"/>

            <!-- Botones -->
            <HBox spacing="8" alignment="CENTER">
                <VBox.margin><Insets top="6"/></VBox.margin>
                <Button fx:id="btnAgregar" text="+ Agregar" onAction="#agregarProducto"
                        prefWidth="70"
                        style="-fx-background-color: #4a8a2a; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 11px;
                               -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button fx:id="btnEditar" text="✎ Editar" onAction="#editarProducto"
                        prefWidth="70"
                        style="-fx-background-color: #e08020; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 11px;
                               -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button fx:id="btnEliminar" text="✖ Eliminar" onAction="#eliminarProducto"
                        prefWidth="70"
                        style="-fx-background-color: #c03030; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 11px;
                               -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button fx:id="btnLimpiar" text="↺ Limpiar" onAction="#limpiarCampos"
                        prefWidth="70"
                        style="-fx-background-color: #888888; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 11px;
                               -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <!-- ── RIGHT PANEL: Lista de Productos ── -->
        <VBox HBox.hgrow="ALWAYS" spacing="8"
              style="-fx-background-color: white; -fx-background-radius: 8;
                     -fx-border-color: #d0d8c8; -fx-border-radius: 8;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <VBox.margin><Insets bottom="12"/></VBox.margin>
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

            <Label text="Lista de Productos Registrados"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 14px; -fx-font-weight: bold;
                          -fx-text-fill: #3a5a2a; -fx-border-color: #c8d8b8;
                          -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;"/>

            <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS"
                       onMouseClicked="#seleccionarProducto"
                       style="-fx-background-radius: 5; -fx-border-color: #d0d8c8;
                              -fx-border-radius: 5; -fx-font-size: 12px;">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="120"/>
                    <TableColumn fx:id="colTipo"   text="Tipo"   prefWidth="90"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80"/>
                    <TableColumn fx:id="colFecha"  text="Fecha de Aplicación" prefWidth="130"/>
                    <TableColumn fx:id="colObs"    text="Observaciones" prefWidth="160"/>
                </columns>
                <placeholder>
                    <Label text="No hay productos registrados."
                           style="-fx-text-fill: #999; -fx-font-style: italic;"/>
                </placeholder>
            </TableView>

            <!-- Info de capacidad -->
            <Label fx:id="lblCapacidad"
                   text="Capacidad del arreglo: 2 | Registros: 0"
                   style="-fx-font-size: 11px; -fx-text-fill: #7a8a70; -fx-font-style: italic;"/>
        </VBox>
    </HBox>

    <!-- ══ FOOTER: Buscar + Guardar + Cargar + Salir ══ -->
    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #eaede4; -fx-border-color: #c8d8b8;
                 -fx-border-width: 1 0 0 0;">
        <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>

        <Label text="Buscar:"
               style="-fx-font-size: 12px; -fx-text-fill: #4a5a40; -fx-font-weight: bold;"/>
        <TextField fx:id="txtBuscar" prefWidth="200" promptText="Nombre del producto..."
                   onKeyReleased="#buscarProducto"
                   style="-fx-background-radius: 5; -fx-border-color: #c8d8b8;
                          -fx-border-radius: 5; -fx-font-size: 12px; -fx-padding: 5;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="💾 Guardar" onAction="#guardarDatos"
                style="-fx-background-color: #3a7a5a; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 11px;
                       -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 6 14;"/>
        <Button text="📂 Cargar" onAction="#cargarDatos"
                style="-fx-background-color: #5a7a3a; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 11px;
                       -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 6 14;"/>
        <Button text="⏻ Salir" onAction="#salir"
                style="-fx-background-color: #6a7a6a; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 11px;
                       -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 6 14;"/>
    </HBox>

</VBox>